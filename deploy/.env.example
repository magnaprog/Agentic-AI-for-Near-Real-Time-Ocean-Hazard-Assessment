# Template only. Every value below that begins with "changeme" is a
# placeholder and must be replaced before this file is used for anything
# reachable by another machine. Copying it unedited produces a running stack
# with a publicly known database superuser password, Grafana admin password,
# and API keys.
#
# Database bootstrap/migration admin role
DB_ADMIN_USER=hazard_admin
DB_ADMIN_PASSWORD=changeme_admin
# DB_HOST, DB_PORT and DB_NAME are what the code reads when you run it
# directly. Under Compose they are pinned to the service names in
# docker-compose.yml, and DB_NAME is pinned again by the timescaledb service's
# POSTGRES_DB, so changing them here does not move the stack. DB_CONNECT_TIMEOUT
# is forwarded and does take effect.
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=hazard_assessment
DB_CONNECT_TIMEOUT=10

# Runtime entrypoints select fixed roles: orchestrator_writer (API),
# pipeline_worker, and ingest_writer. This is their fallback password.
DB_PASSWORD=changeme_role_password

# Optional per-role overrides for provisioning (defaults to DB_PASSWORD)
DB_INGEST_WRITER_PASSWORD=
DB_AGENT_WRITER_PASSWORD=
DB_AGENT_READER_PASSWORD=
DB_AUDIT_READER_PASSWORD=
DB_ORCHESTRATOR_WRITER_PASSWORD=
DB_PIPELINE_WORKER_PASSWORD=
# investigator_writer: provisioned for a planned evidence-investigator
# worker; no running service consumes it yet
DB_INVESTIGATOR_WRITER_PASSWORD=

# Kafka. Read when you run the workers directly; pinned to the Compose service
# name in docker-compose.yml, so editing it here does not move the stack.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Ingest tuning (optional overrides; defaults shown)
# INGEST_DART_EVENT_MODE_TIMEOUT_SEC=14400
# INGEST_DART_POLL_INTERVAL_STANDARD_SEC=60
# INGEST_DART_POLL_INTERVAL_EVENT_SEC=15
# INGEST_COOPS_POLL_INTERVAL_SEC=30
# INGEST_SEISMIC_POLL_INTERVAL_SEC=15
# INGEST_RETRY_MAX_ATTEMPTS=3
# INGEST_RETRY_BACKOFF_SEC=2.0

# Thresholds (versioned config; changes require redeployment)
THRESHOLD_T1=0.35
THRESHOLD_T2=0.60
THRESHOLD_T3=0.85
THRESHOLD_SEISMIC_MIN_MAGNITUDE=6.0
THRESHOLD_ESCALATION_MAGNITUDE=7.5
THRESHOLD_MONITOR_TIMEOUT_HOURS=12.0
THRESHOLD_SEISMIC_ESCALATION_DEPTH_KM=100.0
THRESHOLD_BASIN=pacific

# Optional model-backed after-action API and offline report commentary. While
# the layer is off, after-action returns 501 and offline reports stay
# template-only.
# The LLM layer stays off until LLM_API_KEY or LLM_BASE_URL is set. LLM_MODEL
# has no default and is required once it is on. LLM_PROVIDER accepts anthropic
# (default), openai or google_genai; install the matching extra. For a model you
# host yourself, use LLM_PROVIDER=openai with LLM_BASE_URL and no key.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional flat directory of station calibration CSVs inside the core image.
# Compose mounts archived event data at /app/data, but does not choose one
# event's retrospective calibrations for live processing. Empty loads none.
CALIBRATION_DIR=

# Observability
GRAFANA_PASSWORD=changeme
METRICS_PORT=9100

# Application
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
HAZARD_API_KEY=changeme_internal_api_key
MISSION_CONTROL_API_KEY=changeme_mission_control_api_key
